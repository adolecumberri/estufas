# Copia este archivo a .env.local y rellena los valores de tu proyecto.
#
# PUERTOS LOCALES (ver supabase/config.toml): el stack de Supabase usa
#   8450 = API/REST/Auth (puerto al que ya apunta el móvil), 55322 = Postgres,
#   55323 = Studio, 55324 = Inbucket. (Los 5432x clásicos están en el rango
#    de puertos EXCLUIDOS de Windows: Docker no puede publicarlos.)
#
# Sin EXPO_PUBLIC_SUPABASE_URL la app usa el fallback de src/constants:
#   http://<host-de-expo>:8450  (127.0.0.1 en web/emulador)
#
# La API se sirve directamente en 8450 (sin portproxy):
#   EXPO_PUBLIC_SUPABASE_URL=http://<IP-TAILSCALE-PC>:8450

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:8450
EXPO_PUBLIC_SUPABASE_ANON_KEY=
