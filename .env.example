# Copia este archivo a .env.local y rellena los valores de tu proyecto.
#
# PUERTOS LOCALES (ver supabase/config.toml): el stack de Supabase usa
#   55321 = API/REST/Auth, 55322 = Postgres, 55323 = Studio, 55324 = Inbucket.
#   (Los 5432x clásicos están en el rango de puertos EXCLUIDOS de Windows y
#    Docker no puede publicarlos; por eso 5532x.)
#
# Sin EXPO_PUBLIC_SUPABASE_URL la app usa el fallback de src/constants:
#   http://<host-de-expo>:55321  (127.0.0.1 en web/emulador)
#
# Para el MÓVIL por Tailscale hay dos opciones:
#   A) Puente 8450 en el PC (netsh portproxy; ver reapuntar-8450.bat):
#      EXPO_PUBLIC_SUPABASE_URL=http://<IP-TAILSCALE-PC>:8450
#   B) Acceso directo al puerto (tras permitir 55321 en el firewall):
#      EXPO_PUBLIC_SUPABASE_URL=http://<IP-TAILSCALE-PC>:55321

EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
EXPO_PUBLIC_SUPABASE_ANON_KEY=
